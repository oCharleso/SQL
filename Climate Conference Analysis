-- 1. List all the VIPs (last and first name) and who are presenting in panels. 

SELECT 
vips.last_name,
vips.first_name,
events.event_name,
events.event_type
FROM vips
LEFT JOIN events
ON vips.event = events.event_id
WHERE events.event_type = "Panel"
ORDER BY vips.last_name;

-- 2. List the VIPs who RSVP'd to the welcome reception but NOT to the dinner.

SELECT 
vips.last_name,
vips.first_name
FROM vips JOIN reservations
ON vips.member_id = reservations.member_id
WHERE reservations.welcome_rsvp = 1
AND reservations.dinner_rsvp = 0
ORDER BY vips.last_name;


-- 3. For every VIP with a reservation, show their hotel and the event they are part of (if any), for those attending the dinner.

SELECT 
vips.last_name,
vips.first_name,
hotels.hotel_name,
events.event_name,
events.event_type
FROM vips LEFT JOIN reservations
ON vips.member_id = reservations.member_id
INNER JOIN hotels
ON hotels.hotel_id = reservations.hotel
LEFT JOIN events
ON vips.event = events.event_id
WHERE reservations.dinner_rsvp = 1
ORDER BY vips.last_name;


-- 4. List the VIPs who have no reservation at any hotel yet.

SELECT 
vips.last_name,
vips.first_name
FROM vips
WHERE vips.member_id NOT IN
(SELECT 
reservations.member_id
FROM reservations)
ORDER BY vips.last_name;


-- 5. Show each VIP alongside the VIP they provide feedback to.

SELECT 
giver.last_name AS Giver_last_name,
giver.first_name AS Giver_first_name,
receiver.last_name AS Receiver_last_name,
receiver.first_name AS Receiver_first_name
FROM vips AS giver
LEFT JOIN vips AS receiver
ON giver.provides_feedback_to = receiver.member_id
ORDER BY giver.last_name;



-- 6. How many VIPs are staying at each hotel?

SELECT 
COUNT (vips.member_id) AS Number_of_VIPs_staying_at_the_hotel,
hotels.hotel_name
FROM vips 
LEFT JOIN reservations
ON vips.member_id = reservations.member_id
LEFT JOIN hotels
ON hotels.hotel_id = reservations.hotel
GROUP BY hotels.hotel_name
ORDER BY hotels.hotel_name;



-- 7. Which events have no VIP assigned to them?

SELECT 
events.event_name
FROM events
LEFT JOIN vips
ON vips.event = events.event_id
WHERE member_ID IS null
ORDER BY events.event_name ASC;



-- 8. List all VIPs (last and first name) and the events they are presenting at, including VIPs who are not presenting at an event.

SELECT 
vips.last_name,
vips.first_name,
events.event_name
FROM vips
LEFT JOIN events
ON vips.event = events.event_id
ORDER BY vips.last_name;



-- 9. List the first and last names of VIPs who have made hotel reservations, along with their hotel names.

SELECT
vips.first_name,
vips.last_name,
hotels.hotel_name
FROM vips
LEFT JOIN reservations
ON vips.member_id = reservations.member_id
LEFT JOIN hotels
ON hotels.hotel_id = reservations.hotel
WHERE hotels.hotel_id IS NOT null
ORDER BY vips.first_name;


-- 10. List each VIP's name, event name, hotel name, and welcome RSVP status.

SELECT 
vips.last_name,
vips.first_name,
events.event_name,
hotels.hotel_name,
reservations.welcome_rsvp
FROM vips
LEFT JOIN events
ON vips.event = events.event_id
LEFT JOIN reservations
ON reservations.member_id = vips.member_id
LEFT JOIN hotels
ON hotels.hotel_id = reservations.hotel
ORDER BY vips.last_name;


-- 11. List VIPs who have been members since before the average membership year.

SELECT 
vips.last_name,
vips.first_name,
vips.member_since
FROM vips
WHERE vips.member_since < (
SELECT 
ROUND (AVG(vips.member_since))
FROM vips)
ORDER BY vips.last_name;


-- 12. List pairs of VIPs who work for the same association, showing their names and association.

SELECT 
first_vips.last_name AS First_VIP_last_name,
first_vips.first_name AS First_VIP_first_name,
first_vips.association AS Association_where_both_VIPs_work,
second_vips.last_name AS Second_VIP_last_name,
second_vips.first_name AS Second_VIP_first_name
FROM vips AS first_vips
JOIN vips AS second_vips
ON first_vips.association = second_vips.association
AND first_vips.member_id < second_vips.member_id;

-- 13. For each association type, how many VIPs have a reservation, and how many of them are attending the dinner?

SELECT 
vips.assoc_type,
COUNT (vips.member_id) AS Number_of_VIPs_with_reservation,
SUM (reservations.dinner_rsvp) AS Number_of_VIPs_going_to_dinner
FROM vips
LEFT JOIN reservations
ON vips.member_id = reservations.member_id
WHERE reservations.hotel IS NOT null
GROUP BY (vips.assoc_type);


-- 14. List the number of VIPs in each association.
SELECT
COUNT (vips.member_ID) AS Number_of_VIPs,
vips.association
FROM vips
GROUP BY vips.association;


-- 15. List all VIPs and their associated hotel reservations, including VIPs who may not have made a reservation.

SELECT 
vips.member_id,
vips.last_name,
vips.first_name,
reservations.hotel
FROM vips
LEFT JOIN reservations
ON vips.member_id = reservations.member_id;


-- 16. Find the names of VIPs who have RSVP’d for the welcome event.

SELECT
vips.last_name,
vips.first_name,
reservations.welcome_rsvp
FROM vips
INNER JOIN reservations
ON vips.member_id = reservations.member_id
WHERE reservations.welcome_rsvp = 1
ORDER BY vips.last_name;


-- 17. Retrieve event names, attendee names, and their hotel names.

SELECT 
events.event_name,
vips.last_name,
vips.first_name,
hotels.hotel_name
FROM events
LEFT JOIN vips
ON events.event_id = vips.event
LEFT JOIN reservations
ON reservations.member_id = vips.member_id
LEFT JOIN hotels
ON hotels.hotel_id = reservations.hotel;

-- 18. Find VIPs staying at the hotel with the most reservations.

SELECT
vips.last_name,
vips.first_name,
hotels.hotel_name
FROM vips
LEFT JOIN reservations
ON vips.member_id = reservations.member_id
LEFT JOIN hotels
ON hotels.hotel_id = reservations.hotel
WHERE hotels.hotel_id = (
SELECT
reservations.hotel
FROM reservations
GROUP BY reservations.hotel
ORDER BY COUNT (reservations.hotel) DESC
LIMIT 1);

