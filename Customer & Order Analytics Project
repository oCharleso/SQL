--How many many unique orders were placed in January? In other words, how many distinct order ids do we have?

SELECT 
COUNT (DISTINCT JanSales.orderID) AS janOrders
FROM BIT_DB.JanSales
WHERE LENGTH (JanSales.orderID) = 6
AND JanSales.orderID != 'OrderID';

--How many of those orders were for an iPhone?

SELECT 
COUNT (DISTINCT JanSales.orderID) AS iPhone_janOrders
FROM BIT_DB.JanSales
WHERE LENGTH (JanSales.orderID) = 6
AND JanSales.orderID != 'OrderID'
AND JanSales.Product = 'iPhone';

--Select the customer account numbers for all the orders that were placed in February.

SELECT
DISTINCT customers.acctnum
FROM BIT_DB.customers
RIGHT JOIN BIT_DB.FebSales
ON customers.order_id = FebSales.orderID
WHERE LENGTH (FebSales.orderID) = 6
AND FebSales.orderID != 'orderID';

